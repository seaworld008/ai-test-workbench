# Non-sensitive placeholders only — NEVER commit a real .env file to Git!
TEST_ENV=local
TEST_BASE_URL=
TEST_ALLOWED_HOSTS=127.0.0.1,localhost
TEST_ALLOWED_ORIGINS=
TEST_DENIED_ORIGINS=https://prod.example.com,https://www.example.com
TEST_EGRESS_MODE=allowlist
TEST_EGRESS_EXTRA_HOSTS=
REQUIRE_TEST_TARGET=0

# Mutation & Dangerous Endpoint Policy (/graphql is NOT whitelisted by default)
TEST_ALLOW_MUTATION=0
TEST_BLOCKED_ENDPOINTS=POST /api/pay*,POST /api/payment*,POST /api/sms*,POST /api/notify/real*,DELETE /api/prod*
TEST_STRICT_READONLY=0
TEST_SAFE_WRITE_PATHS=/api/login,/api/auth/login,/__test__/reset

# Runtime Stability Guards (set to 0 or override per-test with test.use({ failOnPageError: false }))
FAIL_ON_PAGEERROR=1
FAIL_ON_SERVER_5XX=1
TEST_IGNORE_PAGEERROR_PATTERNS=
TEST_IGNORE_5XX_PATTERNS=

# Optional dedicated QA test credentials (prefer API login in auth.setup.ts + storageState)
E2E_USERNAME=
E2E_PASSWORD=
