{
  "name": "ai-test-workbench",
  "version": "2.0.0",
  "description": "Reusable local AI-driven E2E testing workbench and Agent Skill built on Playwright Test Agents (Planner/Generator/Healer), Diff-Impact selection, ESLint/TSC anti-fake-green gates, and WCAG 2.2 checks.",
  "license": "MIT",
  "author": "seaworld008",
  "homepage": "https://github.com/seaworld008/ai-test-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seaworld008/ai-test-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/seaworld008/ai-test-workbench/issues"
  },
  "type": "module",
  "bin": {
    "ai-test-workbench": "./tools/aitest.mjs",
    "aitest": "./tools/aitest.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test test/",
    "doctor": "node tools/aitest.mjs doctor",
    "smoke": "node tools/aitest.mjs run --target templates/playwright-qa --suite smoke --audit",
    "demo:app": "node examples/demo-webapp/server.mjs",
    "demo:verify": "node scripts/verify-demo.mjs",
    "help": "node tools/aitest.mjs --help"
  },
  "keywords": [
    "playwright",
    "playwright-test-agents",
    "ai-testing",
    "e2e-testing",
    "agent-skill",
    "codex",
    "claude-code",
    "accessibility",
    "axe-core",
    "quality-gate",
    "mcp"
  ],
  "files": [
    "tools/",
    "src/",
    "scripts/",
    "templates/playwright-qa/package.json",
    "templates/playwright-qa/package-lock.json",
    "templates/playwright-qa/tsconfig.json",
    "templates/playwright-qa/eslint.config.mjs",
    "templates/playwright-qa/playwright.config.ts",
    "templates/playwright-qa/aitest.config.json",
    "templates/playwright-qa/gitignore",
    "templates/playwright-qa/.env.example",
    "templates/playwright-qa/impact-map.json",
    "templates/playwright-qa/waivers.json",
    "templates/playwright-qa/support/",
    "templates/playwright-qa/scripts/",
    "templates/playwright-qa/specs/",
    "templates/playwright-qa/tests/",
    "templates/playwright-qa/playwright/.gitkeep",
    "templates/playwright-qa/docs/",
    "skills/",
    "prompts/",
    "examples/",
    "docs/",
    "README.md",
    "README.en.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "VERSION.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
