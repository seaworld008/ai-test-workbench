  "license": "MIT",
  "author": "seaworld008",
  "homepage": "https://github.com/seaworld008/ai-test-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seaworld008/ai-test-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/seaworld008/ai-test-workbench/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/kernel/index.mjs",
    "./kernel": "./src/kernel/index.mjs",
    "./app": "./src/app/index.mjs",
    "./target-guard": "./src/kernel/target-guard.mjs",
    "./schema-validator": "./src/kernel/schema-validator.mjs"
  },
  "bin": {
    "ai-test-workbench": "./tools/aitest.mjs",
    "aitw": "./tools/aitest.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  },
  "scripts": {
    "test": "node scripts/run-unit-tests.mjs",
    "typecheck": "node scripts/run-typecheck.mjs",
    "sync:vendor": "node scripts/sync-template-vendor.mjs",
    "check:vendor": "node scripts/sync-template-vendor.mjs --check",
    "docs:sync": "node scripts/generate-docs.mjs",
    "lint:docs": "node scripts/check-docs-and-hygiene.mjs",
    "bench": "node scripts/run-bench.mjs",
    "bench:agentic": "node scripts/bench-agentic.mjs",
    "doctor": "node tools/aitest.mjs doctor",
    "mcp:serve": "node tools/aitest.mjs mcp-serve",
    "smoke": "node scripts/run-smoke.mjs",
    "demo:app": "node examples/demo-webapp/server.mjs",
    "demo:verify": "node scripts/verify-demo.mjs",
    "help": "node tools/aitest.mjs --help"
  },
  "keywords": [
    "playwright",
