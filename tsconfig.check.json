{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "typeRoots": ["./templates/playwright-qa/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.mjs",
    "templates/playwright-qa/support/**/*.mjs",
    "templates/playwright-qa/scripts/**/*.mjs"
  ]
}
