{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./templates/playwright-qa/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/core/**/*.mjs"
  ]
}
